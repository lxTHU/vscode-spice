{
    "name": "spice",
    "displayName": "SPICE",
    "description": "SPICE/HSPICE/Spectre language support with syntax highlighting, folding, snippets, symbol navigation, and scope-local net connectivity.",
    "version": "0.4.0",
    "icon": "icon.png",
    "publisher": "xuanli",
    "author": {
        "name": "Xuan Li",
        "url": "https://github.com/lxTHU/vscode-spice"
    },
    "copyright": "Copyright (c) 2022-2026 Xuan Li, Wiener Technology, Beijing",
    "homepage": "https://github.com/lxTHU/vscode-spice",
    "repository": {
        "type": "git",
        "url": "https://github.com/lxTHU/vscode-spice.git"
    },
    "bugs": {
        "url": "https://github.com/lxTHU/vscode-spice/issues"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.67.0"
    },
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:spice"
    ],
    "scripts": {
        "compile": "tsc -p ./",
        "test:parser": "node test/parser_spectre.test.js",
        "test:connectivity": "node test/connectivity.test.js",
        "test:public-boundary": "bash test/public_boundary.test.sh",
        "check": "npm run compile && npm run test:parser && npm run test:aucdl && npm run test:connectivity && npm run test:public-boundary",
        "package:contents": "vsce ls",
        "package:verify": "bash scripts/check-vsix-contents.sh",
        "package:vsix": "npm run check && vsce package --no-dependencies --allow-missing-repository && npm run package:verify",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile",
        "test:aucdl": "node test/parser_aucdl.test.js"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "1.67.0",
        "@vscode/vsce": "3.9.2",
        "typescript": "^5.0.0"
    },
    "overrides": {
        "@azure/abort-controller": "2.1.2",
        "@azure/core-auth": "1.10.1",
        "@azure/core-client": "1.10.1",
        "@azure/core-rest-pipeline": "1.22.2",
        "@azure/core-tracing": "1.3.0",
        "@azure/core-util": "1.13.1",
        "@azure/logger": "1.3.0",
        "@typespec/ts-http-runtime": "0.3.4"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "spice",
        "aucdl",
        "hspice",
        "spectre",
        "syntax",
        "highlighting",
        "navigation",
        "circuit",
        "netlist",
        "pdk",
        "snippets"
    ],
    "contributes": {
        "languages": [
            {
                "id": "spice",
                "aliases": [
                    "SPICE",
                    "spice"
                ],
                "extensions": [
                    ".ckt",
                    ".sp",
                    ".net",
                    ".cir",
                    ".cdl",
                    ".aucdl",
                    ".scs",
                    ".mod",
                    ".mdl",
                    ".lib",
                    ".sub",
                    ".lis",
                    ".dspf",
                    ".l"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "spice",
                "scopeName": "source.spice",
                "path": "./syntaxes/SPICE.tmLanguage"
            }
        ],
        "snippets": [
            {
                "language": "spice",
                "path": "./snippets/snippets.json"
            },
            {
                "language": "spice",
                "path": "./snippets/snippets_meas.json"
            },
            {
                "language": "spice",
                "path": "./snippets/snippets_sources.json"
            },
            {
                "language": "spice",
                "path": "./snippets/snippets_spectre.json"
            }
        ],
        "commands": [
            {
                "command": "spice.selectScope",
                "title": "Select Active .LIB Section",
                "category": "SPICE"
            },
            {
                "command": "spice.clearScope",
                "title": "Clear Manual Section Scope",
                "category": "SPICE"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "spice.selectScope",
                    "when": "editorLangId == spice",
                    "group": "navigation@20"
                },
                {
                    "command": "spice.clearScope",
                    "when": "editorLangId == spice",
                    "group": "navigation@21"
                }
            ]
        }
    }
}
